{
    "openapi": "3.0.0",
    "info": {
        "title": "API Catálogo de Animais para Adoção",
        "description": "API REST para gerenciamento de animais disponíveis para adoção.",
        "version": "1.0.0"
    },
    "paths": {
        "/animais": {
            "get": {
                "tags": [
                    "Animais"
                ],
                "summary": "Lista todos os animais ou filtra por ID/Status",
                "operationId": "f2ddd730ee2664541121e32f68d0e611",
                "responses": {
                    "200": {
                        "description": "Requisição concluída com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Animais"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Animal não encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Animais"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro interno do servidor"
                    }
                }
            },
            "post": {
                "tags": [
                    "Animais"
                ],
                "summary": "Registro de novo animal para adoção",
                "operationId": "be4d0440977f509bde82fe70de61c1f4",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AnimalInput"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Animal cadastrado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Animais"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Campos obrigatórios ausentes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Animais"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro ao cadastrar animal"
                    }
                }
            }
        },
        "/animais/{id}": {
            "get": {
                "tags": [
                    "Animais"
                ],
                "summary": "Obtendo informações de um animal específico",
                "operationId": "caeb4cecb632ee8d0a89b0cb3c322303",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Requisição realizada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Animais"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Animal não encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Animais"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro interno do servidor"
                    }
                }
            },
            "put": {
                "tags": [
                    "Animais"
                ],
                "summary": "Atualizar dados de um animal",
                "operationId": "c31c90321404c60eb53a7f7cfd61d5b6",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AnimalUpdateInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Dados do animal atualizados com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Animais"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Dados insuficientes para atualização",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Animais"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Animal não encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Animais"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro ao atualizar dados"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Animais"
                ],
                "summary": "Exclusão de um animal",
                "operationId": "f44e662e0537a50bf845001dda2bfc04",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Animal removido do sistema com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Animais"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Animal não encontrado para remoção",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Animais"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro interno do servidor"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Animais": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "nome": {
                        "type": "string"
                    },
                    "especie": {
                        "type": "string"
                    },
                    "raca": {
                        "type": "string"
                    },
                    "idade": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "string"
                    },
                    "foto": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "AnimalInput": {
                "required": [
                    "nome",
                    "especie",
                    "raca",
                    "idade"
                ],
                "properties": {
                    "nome": {
                        "type": "string",
                        "example": "Thor"
                    },
                    "especie": {
                        "type": "string",
                        "example": "Cão"
                    },
                    "raca": {
                        "type": "string",
                        "example": "Vira-lata"
                    },
                    "idade": {
                        "type": "integer",
                        "example": 3
                    },
                    "status": {
                        "type": "string",
                        "example": "Disponível"
                    },
                    "foto": {
                        "type": "string",
                        "example": "thor.jpg"
                    }
                },
                "type": "object"
            },
            "AnimalUpdateInput": {
                "properties": {
                    "nome": {
                        "type": "string",
                        "example": "Thor"
                    },
                    "especie": {
                        "type": "string",
                        "example": "Cão"
                    },
                    "raca": {
                        "type": "string",
                        "example": "Vira-lata"
                    },
                    "idade": {
                        "type": "integer",
                        "example": 4
                    },
                    "status": {
                        "type": "string",
                        "example": "Adotado"
                    },
                    "foto": {
                        "type": "string",
                        "example": "thor_novo.jpg"
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Animais",
            "description": "Animais"
        }
    ]
}